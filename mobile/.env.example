# GraphQL endpoint baked into the app at build time (CI sets it from the API_URL secret).
# Default: https://spentiva.exyconn.com/graphql. For a local backend on a phone, use your
# computer's LAN address and change it in the app (Login → Server) if needed.
EXPO_PUBLIC_API_URL=https://spentiva.exyconn.com/graphql
