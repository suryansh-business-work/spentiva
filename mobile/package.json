{
  "name": "spentiva",
  "version": "1.2.2",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "export:check": "expo export --platform android --output-dir .expo-export-check",
    "gen:chartjs": "node scripts/gen-chartjs.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tamagui/config": "^2.7.7",
    "@tamagui/dismissable": "^2.7.7",
    "@tamagui/portal": "^2.7.7",
    "@tanstack/react-query": "^5.102.8",
    "babel-preset-expo": "~57.0.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.21",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@tamagui/babel-plugin": "^2.7.7",
    "@types/react": "~19.2.2",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^16.14.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
