# Copy to .env for local development. In production set these on your host.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spentiva?retryWrites=true&w=majority

# Long random string (min 16 chars), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# OpenAI – parses chat messages (required for the chat). Admins can also set it in the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Email reports (daily / monthly / quarterly / yearly). Admins can also set these in the portal → Settings → Email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Spentiva <reports@example.com>

# Shared secret for GET /ci/config (lets CI read the Slack channel chosen in the app)
CI_TOKEN=
# Encrypts secrets saved from the app (defaults to JWT_SECRET)
SETTINGS_SECRET=
# Comma separated emails that get admin rights (the first user is always admin)
ADMIN_EMAILS=

# Exchange rates (ISO 4217). Must return { rates: { "USD": 1, ... } } for GET {FX_API_URL}/{BASE}
FX_API_URL=https://open.er-api.com/v6/latest

# Comma separated list of allowed origins, or * for all
CORS_ORIGIN=*
